# betomcat (v1) environment. Copy to `.env` and fill in. Never commit `.env`.

# ---- Required ---------------------------------------------------------------
# v1 bot account token (https://www.metaculus.com/futureeval/participate/).
METACULUS_TOKEN=REPLACE_ME
# OpenRouter key funded by Metaculus. The whole LLM budget lives here.
OPENROUTER_API_KEY=REPLACE_ME
# AskNews API key (ank_...). Only the News and Wiki endpoints are used.
ASKNEWS_API_KEY=REPLACE_ME

# ---- Optional ---------------------------------------------------------------
# TypeSafe key for Jev gates (https://console.typesafe.ai). Gates fail open without it.
TYPESAFE_API_KEY=
# Intelligence Workbench server.
IW_URL=http://127.0.0.1:8080
